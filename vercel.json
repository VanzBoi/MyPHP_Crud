{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {"api/*.php": {"runtime": "vercel-php@0.9.0"}},
  "headers": [{"source": "/downloads/:file*", "headers": [
    {"key": "Content-Disposition", "value": "attachment"},
    {"key": "Content-Type", "value": "application/zip"},
    {"key": "X-Content-Type-Options", "value": "nosniff"}
  ]}],
  "rewrites": [
    {"source": "/", "destination": "/api/index.php"},
    {"source": "/index.php", "destination": "/api/index.php"},
    {"source": "/download.php", "destination": "/api/download.php"}
  ]
}
